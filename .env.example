# Documentation only. On Replit, add these in the Secrets tool instead of
# committing a populated .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-value

# Optional: required to enable the Airwallex billing demo.
AIRWALLEX_CLIENT_ID=your-sandbox-client-id
AIRWALLEX_API_KEY=your-sandbox-api-key
AIRWALLEX_WEBHOOK_SECRET=your-sandbox-webhook-secret
AIRWALLEX_ENV=demo

# Replit artifact workflows provide these values.
PORT=8080
BASE_PATH=/